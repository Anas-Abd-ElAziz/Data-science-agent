# Gemini API keys are entered per session in Streamlit or via
# POST /sessions/{id}/api-key for API sessions.

# Langfuse Observability & Tracing (Optional)
# Get your keys from https://cloud.langfuse.com or your local instance
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000  # Or https://cloud.langfuse.com

# Redis LangGraph Checkpointer (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=
REDIS_SESSION_TTL_SECONDS=86400
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_CONNECT_TIMEOUT_SECONDS=3

# Python Execution Sandbox
# Code runs in a subprocess sandbox (with nsjail kernel-level isolation in Docker/Linux).
PYTHON_REPL_TIMEOUT_SECONDS=20
PYTHON_REPL_MEMORY_LIMIT_MB=512

# S3 Dataset Storage (Optional)
AWS_REGION=eu-north-1
S3_DATASET_BUCKET=
S3_DATASET_PREFIX=datasets
S3_DELETE_ON_SESSION_DELETE=false

{
    "family": "data-agent-task",
    "executionRoleArn": "arn:aws:iam::635867291300:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::635867291300:role/data-agent-s3-task-role",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "1024",
    "memory": "2048",
    "containerDefinitions": [
        {
            "name": "api",
            "image": "635867291300.dkr.ecr.eu-north-1.amazonaws.com/data-agent-rep:latest",
            "essential": true,
            "privileged": true,
            "portMappings": [
                {
                    "name": "api",
                    "containerPort": 8000,
                    "hostPort": 0,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "linuxParameters": {
                "capabilities": {
                    "add": [
                        "SYS_ADMIN"
                    ]
                }
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/data-agent-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "eu-north-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 30
            }
        }
    ]
}
